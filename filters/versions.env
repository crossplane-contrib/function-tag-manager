# Provider versions used to generate the resource filters in
# filters/zz_provider-upjet-*.go. Renovate updates these pins; a PR that
# changes this file triggers .github/workflows/update-filters.yml, which
# regenerates the filters from the pinned provider tags.
# renovate: datasource=github-releases depName=crossplane-contrib/provider-upjet-aws
UPJET_AWS_VERSION=v2.9.0
# renovate: datasource=github-releases depName=crossplane-contrib/provider-upjet-azure
UPJET_AZURE_VERSION=v2.8.0
