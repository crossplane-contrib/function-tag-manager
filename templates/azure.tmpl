package filters

// NewAzureResourceFilter returns a ProviderFilter for the resources that
// support tags. The Resources were generated by querying the provider CRDs for
// spec.forProvider.{{.Field}} support.
func NewAzureResourceFilter() ProviderFilter {
    return NewProviderFilter({{printf "%q" .Field}}, map[string]bool{
    {{- range .Resources }}
        {{printf "%q" .GroupKind}}: {{.Enabled}},
    {{- end }}
    }){{- if and .ObservedField (ne .ObservedField .Field)}}.WithObservedField({{printf "%q" .ObservedField}}){{- end}}
}
