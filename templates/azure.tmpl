package filters

// NewAzureResourceFilter returns a map of resources that support tags.
// These values were generated by querying the provider CRDs for spec.forProvider.{{.Field}} support.
func NewAzureResourceFilter() ProviderFilter {
    return NewProviderFilter("{{.Field}}", map[string]bool{
    {{- range .Resources }}
        "{{.GroupKind}}": {{.Enabled}},
    {{- end }}
    })
}
